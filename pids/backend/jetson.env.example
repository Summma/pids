# Copy to pids/backend/jetson.env on the Jetson and adjust for the wiring.

PIDS_BACKEND_HOST=0.0.0.0
PIDS_BACKEND_PORT=9090
# Uncomment if a partial .venv-jetson exists but system Python has the
# installed Jetson sensor packages.
# PIDS_PYTHON=/usr/bin/python3

# Ouster connected directly to the Jetson over Ethernet.
PIDS_LIDAR_HOST=169.254.62.165
PIDS_LIDAR_FPS=5
PIDS_LIDAR_MAX_POINTS=60000

# Visible/USB camera connected directly to the Jetson.
PIDS_CAMERA_DEVICE=/dev/video0
PIDS_CAMERA_WIDTH=640
PIDS_CAMERA_HEIGHT=480
PIDS_CAMERA_FPS=15
PIDS_CAMERA_JPEG_QUALITY=75

# Optional Boson thermal device. Leave empty or set -1 to disable /thermal.
# If the Boson is the thermal stream on /dev/video1, set PIDS_THERMAL_DEVICE=1.
PIDS_THERMAL_DEVICE=-1
PIDS_THERMAL_FPS=10

PIDS_DETECTION_MODE=indoor_human
PIDS_DETECTION_FPS=2

# Optional PointPillars support/proposal signal. Start
# jetson_detector/pointpillars_server.py on the Jetson, then set:
# PIDS_DETECTION_MODE=auto
# PIDS_POINTPILLARS_ENDPOINT=tcp://127.0.0.1:5555
PIDS_POINTPILLARS_ENDPOINT=
PIDS_POINTPILLARS_TIMEOUT_MS=250
PIDS_POINTPILLARS_MAX_POINTS=80000

PIDS_GEMINI_API_MODE=auto
PIDS_GEMINI_PROJECT=ns-hackathon-495208
PIDS_GEMINI_LOCATION=global
PIDS_GEMINI_MODEL=gemini-2.5-flash
